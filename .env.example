# Copy to .env (gitignored). Never commit real keys.

# DeepSeek / OpenAI-compatible (live improver)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Sculpt — provider-prefixed ids for OpenCode-style channels
SCULPT_IMPROVER_MODEL=deepseek/deepseek-chat
SCULPT_SOLVER_MODEL=deepseek/deepseek-chat
SCULPT_JUDGE_MODEL=deepseek/deepseek-chat
SCULPT_PHASE_WIDTH=2
# SCULPT_RUNS_DIR=
